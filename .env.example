# Copy to .env and fill in. .env is gitignored — it is the ONLY place secrets live.
#
# For scheduled runs on GitHub Actions these same names become repository
# secrets (Settings > Secrets and variables > Actions), with one exception
# noted under GITHUB_TOKEN. Verify everything with:
#
#     python tools/preflight.py

# =========================================================================
# Required
# =========================================================================

# --- YouTube Data API v3 ---
# https://console.cloud.google.com/apis/credentials
# Enable "YouTube Data API v3" on the project, then create an API key.
# 10,000 quota units/day, resetting midnight Pacific. A --seeds-only run costs
# roughly 150; a run with discovery costs roughly 950.
YOUTUBE_API_KEY=

# --- Report delivery (SMTP) ---
# Scheduled runs must use SMTP with an app password. The OAuth path cannot
# refresh unattended: an app left in "Testing" expires refresh tokens every 7
# days, and publishing out of Testing requires a homepage, privacy policy and
# terms of service on a verified domain.
# Create at myaccount.google.com/apppasswords (needs 2-Step Verification).
GMAIL_APP_PASSWORD=
# Only if the sending account differs from REPORT_RECIPIENT.
GMAIL_ADDRESS=

# Where the finished report goes. Comma-separated for several recipients.
REPORT_RECIPIENT=

# =========================================================================
# Strongly recommended — the run degrades without these, it does not fail
# =========================================================================

# --- Anthropic (writes the report narrative) ---
# https://console.anthropic.com/settings/keys
# Without it, tools/author_report_spec.py falls back to a deterministic
# template: correct numbers, but the same sentences every week.
# Roughly $0.15-0.25 per weekly run on claude-opus-5.
ANTHROPIC_API_KEY=
# Optional overrides.
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=high

# --- GitHub (adoption signal for the trend report) ---
# Fine-grained PAT, public read only: github.com > Settings > Developer settings
# Without it, search is limited to 10 req/min and the run is slow and partial.
#
# ON GITHUB ACTIONS: do not create a secret with this name. GitHub reserves the
# GITHUB_ prefix and will reject it. The workflow uses the token Actions injects
# automatically, which is already authenticated.
GITHUB_TOKEN=

# =========================================================================
# Optional
# =========================================================================

# --- Transcript proxy ---
# YouTube blocks transcript requests from datacenter IPs — AWS, GCP, Azure,
# Vercel, Colab and GitHub Actions runners all fail. A residential proxy is the
# only way to run that step off a home connection.
# Leave unset to connect directly (correct for local runs).
#   webshare  -> set USERNAME and PASSWORD
#   generic   -> set HTTP_URL (and optionally HTTPS_URL)
TRANSCRIPT_PROXY_PROVIDER=
TRANSCRIPT_PROXY_USERNAME=
TRANSCRIPT_PROXY_PASSWORD=
TRANSCRIPT_PROXY_HTTP_URL=
TRANSCRIPT_PROXY_HTTPS_URL=

# --- Scope overrides ---
# config/scope.json holds the defaults. These override it per run, which is how
# a scheduler tunes a run without committing a file change. Leave blank to use
# the file.
SCOPE_LOOKBACK_DAYS=
SCOPE_MAX_VIDEOS_PER_CHANNEL=
SCOPE_MIN_VIDEO_DURATION=
SCOPE_MAX_DISCOVERY_SEARCHES=
SCOPE_MAX_CHANNELS_PER_QUERY=
SCOPE_MIN_CHANNEL_SUBSCRIBERS=
SCOPE_TRANSCRIPT_TOP_N=

# --- Google Workspace (Sheets / Slides / Drive deliverables) ---
# Only needed for workflows that write to Drive. Not used by the trend report,
# and not usable unattended — the OAuth flow needs a browser.
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
GOOGLE_DRIVE_FOLDER_ID=

# --- Runtime ---
LOG_LEVEL=INFO
